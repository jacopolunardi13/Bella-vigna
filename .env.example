# Bella Vigna Firenze — Guest Guide & Commerce
#
# Copy to .env and fill in. Never commit the filled-in version: .env is ignored.
# The server reads these at boot; nothing secret is stored in the repository.
#
# EVERY value here is Bella Vigna's own. Do not copy LunArt's environment:
#   - its data directory would hold LunArt's guests (the server refuses to start
#     on a store stamped for another property, but do not rely on finding out that way);
#   - its CARD_SIGNING_KEY, STAFF_TOKEN and VAPID keys must not be shared, so a card,
#     a Staff phone or a push subscription of one property can never act on the other;
#   - LUNART_* variable names are not read here at all (GUIDE_* replaces them).

# Where the guide answers. Used to build Stripe's return URLs.
PUBLIC_URL=http://localhost:4173
PORT=4173

# ── Stripe ──────────────────────────────────────────────────────────────────
# Leave STRIPE_SECRET_KEY empty to run the built-in mock checkout: the whole flow
# works end to end, no money moves, and nothing talks to Stripe.
# Start with the test keys (sk_test_... / pk_test_...).
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# From `stripe listen` or the dashboard. Without it, webhooks are refused.
STRIPE_WEBHOOK_SECRET=

# ── Privilege Card ──────────────────────────────────────────────────────────
# Signs the rotating card codes. 32+ random bytes, hex:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If this is missing a random one is generated at boot, which invalidates every
# issued card on every restart. Set it before anybody holds a real card.
CARD_SIGNING_KEY=
CARD_CODE_PERIOD_SECONDS=60
CARD_CODE_GRACE=1

# ── Operations ──────────────────────────────────────────────────────────────
# Protects the provider confirm/decline endpoints. Any long random string.
STAFF_TOKEN=

# Where orders and cards are written. Empty keeps them in memory, which is fine
# for a preview and loses everything on restart.
GUIDE_DATA_DIR=

# Sell items whose price is a placeholder. At Bella Vigna that is EVERY price until
# the operator confirms them (commerce/prices.js). Leave off in production.
ALLOW_PLACEHOLDER_PRICES=
# Fill the unpriced products with obviously-fake values so the flow can be walked.
GUIDE_DEV_PRICES=

# Demonstration mode for the staging service: refuses to read any credential below
# (Stripe, Gmail, VAPID, calendar, WIFI_PASSWORD), seeds two invented reservations.
GUIDE_PREVIEW=

# ── Wi-Fi ───────────────────────────────────────────────────────────────────
# Guests join by scanning the QR code in the room; the SSID (WINDTRE-96F14E) is in
# the guide. The password is optional and secret: when set, it is shown only on a
# guest's own personal link, during their stay, as the fallback for a phone that
# will not scan the QR. Never commit it, never paste it in a document or a log.
# Ignored in preview.
WIFI_PASSWORD=

# ── Reservations ────────────────────────────────────────────────────────────
# Where the QuoVai notifications are read from. Empty means nobody reads them and
# reservations have to be typed into the Staff app by hand.
#   memory  in-process queue, for the preview and the tests
#   gmail   the real mailbox — implemented, waiting on the three values below
# Bella Vigna has its own QuoVai account: read ITS notifications only. If the
# mailbox is shared with LunArt, GMAIL_QUERY must select Bella Vigna's (the parser
# also refuses any notification whose "Struttura" names another property).
RESERVATION_MAILBOX=
#
# One-time setup, in the Google account that receives the QuoVai emails:
#   1. console.cloud.google.com -> a project -> enable the Gmail API
#   2. OAuth consent screen -> External -> add that account as a test user
#   3. Credentials -> OAuth client ID -> Desktop app -> gives the id and the secret
#   4. Consent once with the scopes below; keep the refresh token it returns
# Scopes: gmail.readonly (to read) and gmail.modify (to label what has been handled);
# add gmail.send if the same account also sends the guide email.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_QUERY=from:quovai "Bella Vigna" newer_than:7d
# Optional: a label applied once a notification has been ingested. Without it the
# store's own de-duplication does the whole job, which it is designed to do.
GMAIL_PROCESSED_LABEL_ID=
# A ceiling per poll, so a first run against a full inbox cannot take all morning.
GMAIL_MAX_MESSAGES=50
# How often to read it, in minutes. 0 turns polling off.
RESERVATION_POLL_MINUTES=0

# QuoVai's API or webhook, if it turns out they offer one. The adapter interface
# exists; these are what it would need. Until then the webhook route answers 503.
QUOVAI_API_BASE=
QUOVAI_API_KEY=
QUOVAI_WEBHOOK_SECRET=

# iCal feeds, for reconciliation only — they are a safety net, not a source.
#   Standard:https://…/standard.ics,Deluxe:https://…/deluxe.ics,Terrazza:https://…/terrazza.ics
#   (room ids from data/rooms.js) or a bare comma-separated list
QUOVAI_ICAL_FEEDS=
ICAL_POLL_MINUTES=0

# ── The guest guide email ───────────────────────────────────────────────────
# `gmail` sends through the Gmail API with the credentials above, from MAIL_FROM.
# Empty — or gmail without credentials — means every send is simulated: the body is
# rendered and recorded, and nothing leaves. Scheduling works either way.
MAIL_PROVIDER=
# No default: Bella Vigna's sending address is still to be decided (Property Pack
# §7). Without it every guide email stays simulated, whatever MAIL_PROVIDER says.
MAIL_FROM=
MAIL_REPLY_TO=
DELIVERY_POLL_MINUTES=0

# ── Staff notifications ─────────────────────────────────────────────────────
# Web Push, through the `web-push` library. Generate a pair once with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# The subject is a contact for the push services, e.g. mailto:<Bella Vigna address>.
# Generate Bella Vigna's own pair: do not reuse LunArt's.
# Without them the Staff app works, polls, and says push is not configured.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# ── The hair professional's calendar ────────────────────────────────────────
# Reading free/busy removes the hours the professional is already committed to; the
# write calendar is where confirmed Bella Vigna bookings land. The hours a guest can book
# always come from commerce/schedule.js — the calendar only ever takes away.
#
# One-time setup:
#   1. console.cloud.google.com -> the same project -> enable the Calendar API
#   2. Credentials -> Service account -> keys -> JSON; the private key goes below,
#      newlines escaped as \n if your host needs it
#   3. In Google Calendar, share BOTH calendars with the service account's address:
#      his own as "See only free/busy", and a new one called "Bella Vigna Hair Bookings"
#      as "Make changes to events"
#   4. Put each calendar's id below (Settings -> Integrate calendar -> Calendar ID)
# His iPhone keeps using Apple Calendar: it subscribes to the Google account and
# syncs both ways.
PROVIDER_CALENDAR=google-calendar
GOOGLE_CALENDAR_ID=
GOOGLE_CALENDAR_WRITE_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_KEY=
# Only for a Workspace domain with delegation; empty for a shared calendar.
GOOGLE_CALENDAR_SUBJECT=

# ── Housekeeping ────────────────────────────────────────────────────────────
# How often finished stays are retired, in minutes. 0 turns it off.
HOUSEKEEPING_MINUTES=60
